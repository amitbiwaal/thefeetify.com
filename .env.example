# ---------------------------------------------------------------------------
# REQUIRED in production (Vercel → Project → Settings → Environment Variables)
# ---------------------------------------------------------------------------

# Password for /admin. Use a long random one (16+ characters).
ADMIN_PASSWORD=

# Added automatically when you connect a Vercel Blob store to the project
# (Vercel → Storage → Create → Blob → Public). Needed to save posts, images
# and contact messages in production.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Secret used to sign admin sessions and encrypt contact messages.
# If empty, it is derived from ADMIN_PASSWORD.
AUTH_SECRET=

# Public site URL without trailing slash (default: https://thefeetify.com)
NEXT_PUBLIC_SITE_URL=

# Shown on the contact and legal pages when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Override the affiliate link used by every call-to-action button.
NEXT_PUBLIC_AFFILIATE_URL=
